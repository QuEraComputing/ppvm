device circuit.n_qubits 5;

// Data: q0, q1, q2.
// Syndrome ancillas: q3, q4.
fn @main() {
    cpu::cpu.const u64, 1
    cpu::cpu.const f64, 0.25
    cpu::cpu.const f64, 0.0
    cpu::cpu.const f64, 0.0
    circuit::circuit.paulierror

    cpu::cpu.const u64, 0
    cpu::cpu.const u64, 3
    circuit::circuit.cnot
    cpu::cpu.const u64, 1
    cpu::cpu.const u64, 3
    circuit::circuit.cnot
    cpu::cpu.const u64, 3
    circuit::circuit.measure

    cpu::cpu.const u64, 1
    cpu::cpu.const u64, 4
    circuit::circuit.cnot
    cpu::cpu.const u64, 2
    cpu::cpu.const u64, 4
    circuit::circuit.cnot
    cpu::cpu.const u64, 4
    circuit::circuit.measure

    cpu::cpu.const u32, 1
    cpu::cpu.eq u32
    cpu::cpu.cond_br @s12_one, @s12_zero

cpu::cpu.label @s12_one
    cpu::cpu.const u32, 1
    cpu::cpu.eq u32
    cpu::cpu.cond_br @correct_q1, @correct_q2

cpu::cpu.label @s12_zero
    cpu::cpu.const u32, 1
    cpu::cpu.eq u32
    cpu::cpu.cond_br @correct_q0, @readout

cpu::cpu.label @correct_q0
    cpu::cpu.const u64, 0
    circuit::circuit.x
    cpu::cpu.br @readout

cpu::cpu.label @correct_q1
    cpu::cpu.const u64, 1
    circuit::circuit.x
    cpu::cpu.br @readout

cpu::cpu.label @correct_q2
    cpu::cpu.const u64, 2
    circuit::circuit.x

cpu::cpu.label @readout
    cpu::cpu.const u64, 0
    circuit::circuit.measure
    cpu::cpu.const u64, 1
    circuit::circuit.measure
    cpu::cpu.const u64, 2
    circuit::circuit.measure
    cpu::cpu.ret 0
}
