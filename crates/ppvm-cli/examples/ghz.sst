device circuit.n_qubits 3;

// Prepare a 3-qubit GHZ state (|000> + |111>)/sqrt(2) and measure every qubit.
// The three outcomes are perfectly correlated, so each shot reads 0 0 0 or 1 1 1.
fn @main() {
    cpu::cpu.const u64, 0
    circuit::circuit.h

    cpu::cpu.const u64, 0
    cpu::cpu.const u64, 1
    circuit::circuit.cnot

    cpu::cpu.const u64, 1
    cpu::cpu.const u64, 2
    circuit::circuit.cnot

    cpu::cpu.const u64, 0
    circuit::circuit.measure

    cpu::cpu.const u64, 1
    circuit::circuit.measure

    cpu::cpu.const u64, 2
    circuit::circuit.measure

    cpu::cpu.ret 0
}
