    .text(ppvm):
        fn @main() {
            // Loop + feed-forward demo.
            // Repeat a body 3 times (a counted loop); in each round flip a fair coin on
            // q0 and, based on the measured outcome, conditionally toggle q1 (the
            // feed-forward). q1 is flipped once per coin that came up 1, so the final q1
            // measurement equals the parity (XOR) of the three coin flips. Each shot
            // prints 4 bits: q0_round1 q0_round2 q0_round3 q1.

            // Loop counter starts at 0 and lives on the bottom of the stack.
            execution::program::const_u64 0

            label @loop
                // Flip a fair coin: H then measure q0 (pushes outcome 0/1 as u32).
                execution::program::const_u64 0
                circuit::circuit::h
                execution::program::const_u64 0
                circuit::circuit::measure

                // Feed-forward: if the outcome was 1, apply X to q1.
                execution::program::const_u32 1
                cpu::cpu::eq_u32
                execution::program::cond_br @flip, @next

            label @flip
                execution::program::const_u64 1
                circuit::circuit::x
                execution::program::br @next

            label @next
                // counter += 1, then loop while counter < 3.
                execution::program::const_u64 1
                cpu::cpu::add_u64
                execution::program::dup
                execution::program::const_u64 3
                cpu::cpu::lt_u64
                execution::program::cond_br @loop, @done

            label @done
                // Final readout of q1.
                execution::program::const_u64 1
                circuit::circuit::measure
                execution::program::ret 0
        }
    .text(ppvm).
    .section(ppvm).
.section(root).
