device circuit.n_qubits 1;

fn @main() {
    cpu::cpu.const u64, 0

cpu::cpu.label @loop
    cpu::cpu.const u64, 0
    circuit::circuit.h
    cpu::cpu.const u64, 0
    circuit::circuit.measure

    // stop here to investigate
    cpu::cpu.breakpoint

    cpu::cpu.const u32, 1
    cpu::cpu.eq u32
    cpu::cpu.cond_br @flip, @next

cpu::cpu.label @flip
    cpu::cpu.const u64, 0
    circuit::circuit.x

cpu::cpu.label @next
    cpu::cpu.const u64, 1
    cpu::cpu.add u64
    cpu::cpu.dup
    cpu::cpu.const u64, 2
    cpu::cpu.lt u64
    cpu::cpu.cond_br @loop, @done

cpu::cpu.label @done
    cpu::cpu.ret 0
}
