    .text(ppvm):
    // Binary arithmetic pushes operands in source order: lhs, then rhs.
    // The CPU pops rhs first and lhs second before applying the operation.
        fn @main() {
            execution::program::const_u64 10
            execution::program::const_u64 3
            cpu::cpu::sub_u64
            execution::program::const_u64 7
            cpu::cpu::eq_u64
            execution::program::cond_br @check_div, @fail_sub

        label @check_div
            execution::program::const_u64 10
            execution::program::const_u64 3
            cpu::cpu::div_u64
            execution::program::const_u64 3
            cpu::cpu::eq_u64
            execution::program::cond_br @check_rem, @fail_div

        label @check_rem
            execution::program::const_u64 10
            execution::program::const_u64 3
            cpu::cpu::rem_u64
            execution::program::const_u64 1
            cpu::cpu::eq_u64
            execution::program::cond_br @check_mul, @fail_rem

        label @check_mul
            execution::program::const_u64 10
            execution::program::const_u64 3
            cpu::cpu::mul_u64
            execution::program::const_u64 30
            cpu::cpu::eq_u64
            execution::program::cond_br @check_add, @fail_mul

        label @check_add
            execution::program::const_u64 10
            execution::program::const_u64 3
            cpu::cpu::add_u64
            execution::program::const_u64 13
            cpu::cpu::eq_u64
            execution::program::cond_br @success, @fail_add

        label @fail_sub
            execution::program::br @fail
        label @fail_div
            execution::program::br @fail
        label @fail_rem
            execution::program::br @fail
        label @fail_mul
            execution::program::br @fail
        label @fail_add
            execution::program::br @fail

        label @fail
            execution::program::const_u64 0
            circuit::circuit::x
            execution::program::br @success

        label @success
            execution::program::const_u64 0
            circuit::circuit::measure
            execution::program::ret 0
        }
