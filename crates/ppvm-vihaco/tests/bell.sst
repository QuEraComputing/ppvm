device circuit.n_qubits 2;

fn @main() {
    cpu::cpu.const u64, 0
    circuit::circuit.h

    cpu::cpu.const u64, 0
    cpu::cpu.const u64, 1
    circuit::circuit.cnot

    cpu::cpu.const u64, 0
    circuit::circuit.measure

    cpu::cpu.const u64, 1
    circuit::circuit.measure

    cpu::cpu.ret 0
}
