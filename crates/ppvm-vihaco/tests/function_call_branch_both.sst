    .header(ppvm).
    .text(ppvm):
    // Exercises a helper that returns the tri-state measurement outcome via
    // `ret 1`, with main branching on loss first, then on the 0/1 outcome.
    //
    // Layout after `call 0, @measure_q0` returns: stack = [outcome] where
    // outcome ∈ {0, 1, 2} (2 = Lost).
    //
    // Loss prob is 0.5, so:
    //   P(lost)               = 0.5  → q1 flipped to |1>          → m1 = 1
    //   P(kept ∧ outcome = 1) = 0.25 → q1 flipped to |1>          → m1 = 1
    //   P(kept ∧ outcome = 0) = 0.25 → q1 stays in |0>             → m1 = 0
    // → P(m1 = 1) = 0.75.

        fn @main() {
            execution::program::const_u64 0
            circuit::circuit::h

            execution::program::const_u64 0
            execution::program::const_f64 0.5
            circuit::circuit::loss

            execution::program::call 0, @measure_q0

            // Stack: [outcome]. Branch on Lost (outcome == 2) first.
            execution::program::dup
            execution::program::const_u32 2
            cpu::cpu::eq_u32
            execution::program::cond_br @lost, @kept

            label @lost
                // is_lost = true: outcome is meaningless. Flip q1 to mark "lost"
                // path. The leftover `outcome` value on the stack is harmless because
                // we halt at @final without reading it.
                execution::program::const_u64 1
                circuit::circuit::x
                execution::program::br @final

            label @kept
                // Stack: [outcome (0 or 1)]. Compare to 1 to derive a bool.
                execution::program::const_u32 1
                cpu::cpu::eq_u32
                execution::program::cond_br @outcome_one, @outcome_zero

            label @outcome_one
                execution::program::const_u64 1
                circuit::circuit::x
                execution::program::br @final

            label @outcome_zero
                execution::program::br @final

            label @final
                execution::program::const_u64 1
                circuit::circuit::measure
                execution::program::halt
        }

        fn @measure_q0() {
            execution::program::const_u64 0
            circuit::circuit::measure
            // Stack: [outcome]
            execution::program::ret 1
        }
    .text(ppvm).
    .section(ppvm).
.section(root).
