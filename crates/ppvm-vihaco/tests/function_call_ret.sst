device circuit.n_qubits 2;


fn @main() {
    // Put q0 into |+>.
    cpu::cpu.const u64, 0
    circuit::circuit.h

    // Measure q1 via a helper that returns the outcome on top of the stack.
    cpu::cpu.call 0, measure_q1

    // Stack: [outcome]. Compare to 1 to derive a bool for cond_br.
    cpu::cpu.const u32, 1
    cpu::cpu.eq u32
    cpu::cpu.cond_br @one, @zero

    cpu::cpu.label @one
        // outcome was 1: apply X to q0 as a correction.
        cpu::cpu.const u64, 0
        circuit::circuit.x
        cpu::cpu.br @done

    cpu::cpu.label @zero
        cpu::cpu.br @done

    cpu::cpu.label @done
        cpu::cpu.ret 0
}

fn @measure_q1() -> u32 {
    cpu::cpu.const u64, 1
    circuit::circuit.h

    cpu::cpu.const u64, 1
    circuit::circuit.measure
    // Stack: [outcome]

    cpu::cpu.ret 1
}
