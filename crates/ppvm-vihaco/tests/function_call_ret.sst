    .text(ppvm):
        fn @main() {
            // Put q0 into |+>.
            execution::program::const_u64 0
            circuit::circuit::h

            // Measure q1 via a helper that returns the outcome on top of the stack.
            execution::program::call 0, @measure_q1

            // Stack: [outcome]. Compare to 1 to derive a bool for cond_br.
            execution::program::const_u32 1
            cpu::cpu::eq_u32
            execution::program::cond_br @one, @zero

            label @one
                // outcome was 1: apply X to q0 as a correction.
                execution::program::const_u64 0
                circuit::circuit::x
                execution::program::br @done

            label @zero
                execution::program::br @done

            label @done
                execution::program::ret 0
        }

        fn @measure_q1() -> u32 {
            execution::program::const_u64 1
            circuit::circuit::h

            execution::program::const_u64 1
            circuit::circuit::measure
            // Stack: [outcome]

            execution::program::ret 1
        }
