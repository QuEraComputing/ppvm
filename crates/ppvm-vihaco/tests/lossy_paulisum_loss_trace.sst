.section(root):
    .section(ppvm):
    .header(ppvm):
        circuit.n_qubits 2;
        circuit.backend lossy_paulisum;
        circuit.observable ZZ;
        metadata {
            strings: ["main", "lossy_paulisum_loss_trace.sst", "Z?*"],
            functions: [
                {
                    name: 0, // main
                    signature: { params: [], ret: [] },
