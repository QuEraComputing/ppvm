    .header(ppvm).
    .text(ppvm):
    // LossyPauliSum end-to-end with a single-qubit loss channel. The header
    // seeds `ZZ`, the body Heisenberg-propagates ZZ backward through CNOT(0,1)
    // to Z_1 (= IZ), then applies loss(q0, p=0.3). The pattern `Z?*` matches
    // all Z/I-only Paulis on the surviving qubits, so the trace picks up the
    // IZ coefficient that survived the loss channel.
    //
    // The Rust-side test cross-checks this against a pure-Rust LossyPauliSum
    // reference with the same Config/strategy, so we don't have to commit to
    // the exact loss-channel value — only that .sst and direct API agree.
        fn @main() {
            execution::program::const_u64 0
            execution::program::const_u64 1
            circuit::circuit::cnot

            execution::program::const_u64 0
            execution::program::const_f64 0.3
            circuit::circuit::loss

            circuit::circuit::truncate

            execution::program::const_string "Z?*"
            circuit::circuit::trace
            execution::program::ret 0
        }
    .text(ppvm).
    .section(ppvm).
.section(root).
