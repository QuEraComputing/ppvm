    .text(ppvm):
        fn @main() {
            // Heisenberg backward through GHZ prep: forward is H(0); CNOT(0,1); CNOT(1,2),
            // so we apply CNOT(1,2); CNOT(0,1); H(0) here.
            //
            // XXX --CNOT(1,2)--> XXI (X_2 on target absorbs into X_1 on control)
            //      --CNOT(0,1)--> XII
            //      --H(0)------> ZII
            // Trace against Z/I-only Paulis picks up the coefficient of ZII = 1.0.
            execution::program::const_u64 1
            execution::program::const_u64 2
            circuit::circuit::cnot

            execution::program::const_u64 0
            execution::program::const_u64 1
            circuit::circuit::cnot

            execution::program::const_u64 0
            circuit::circuit::h

            execution::program::const_string "Z?*"
            circuit::circuit::trace
            execution::program::ret 0
        }
    .text(ppvm).
    .section(ppvm).
.section(root).
