    .text(ppvm):
        fn @main() {
            // PauliSum already runs in the Heisenberg picture: `circuit.ry` performs
            // RY(θ)† Z RY(θ) = cos(θ)·Z + sin(θ)·X. A single gate means no
            // reversal is needed beyond that. Trace against Z/I-only Paulis picks
            // up the cos(θ) coefficient on Z; the sin(θ)·X term contributes 0.
            execution::program::const_u64 0
            execution::program::const_f64 0.7
            circuit::circuit::ry

            execution::program::const_string "Z?*"
            circuit::circuit::trace
            execution::program::ret 0
        }
