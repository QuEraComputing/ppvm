    .text(ppvm):
        fn @main() {
            // Two Trotter layers of RXX(0.1) RZZ(0.05), with explicit truncate
            // between layers. RXX branches Z->Y so the sum grows; truncate prunes
            // small-coefficient terms via `coefficient_threshold`.
            execution::program::const_u64 0
            execution::program::const_u64 1
            execution::program::const_f64 0.1
            circuit::circuit::rxx

            execution::program::const_u64 0
            execution::program::const_u64 1
            execution::program::const_f64 0.05
            circuit::circuit::rzz

            circuit::circuit::truncate

            execution::program::const_u64 0
            execution::program::const_u64 1
            execution::program::const_f64 0.1
            circuit::circuit::rxx

            execution::program::const_u64 0
            execution::program::const_u64 1
            execution::program::const_f64 0.05
            circuit::circuit::rzz

            circuit::circuit::truncate

            execution::program::const_string "Z?*"
            circuit::circuit::trace
            execution::program::ret 0
        }
