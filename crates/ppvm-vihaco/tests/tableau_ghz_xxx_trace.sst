device circuit.n_qubits 3;

fn @main() {
    // Forward GHZ prep: H(0); CNOT(0, 1); CNOT(1, 2) → (|000⟩+|111⟩)/√2.
    cpu::cpu.const u64, 0
    circuit::circuit.h

    cpu::cpu.const u64, 0
    cpu::cpu.const u64, 1
    circuit::circuit.cnot

    cpu::cpu.const u64, 1
    cpu::cpu.const u64, 2
    circuit::circuit.cnot

    // `X{3}` matches exactly the Pauli word XXX. ⟨GHZ|XXX|GHZ⟩ = 1.
    cpu::cpu.const str, "X{3}"
    circuit::circuit.trace
    cpu::cpu.ret 0
}
