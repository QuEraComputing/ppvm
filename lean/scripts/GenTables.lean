import PPVM.Kernels.Model

/-!
Prints `crates/ppvm-pauli-kernels/tests/generated/tables.rs`: the conjugation
and product tables of the matrix model in `PPVM.Kernels.Model`, found by search
over all candidate images. It never reads the rule transcriptions, so the Rust
tests compare the Rust rules against the matrices, not against themselves.

Run from `lean/`:
  lake env lean --run scripts/GenTables.lean > ../crates/ppvm-pauli-kernels/tests/generated/tables.rs
-/

open PPVM.Kernels

def bools : List Bool := [false, true]

def b (v : Bool) : String := if v then "true" else "false"

/-- The `(x', z', flip)` with `G† P G = (−1)^flip · P'`, by search. -/
def image1 (g : Gate 2) (x z : Bool) : Option (Bool × Bool × Bool) :=
  let cands := bools.flatMap fun x' => bools.flatMap fun z' => bools.map fun f => (x', z', f)
  cands.find? fun (x', z', f) =>
    decide (Mat.Eq (g.heis (pauli x z)) (Mat.smul (GI.ofInt g.scale * sgn f) (pauli x' z')))

def image2 (g : Gate 4) (xa za xb zb : Bool) : Option (List Bool) :=
  let cands := bools.flatMap fun a => bools.flatMap fun c => bools.flatMap fun d =>
    bools.flatMap fun e => bools.map fun f => [a, c, d, e, f]
  cands.find? fun v =>
    decide (Mat.Eq (g.heis (pauli2 xa za xb zb))
      (Mat.smul (GI.ofInt g.scale * sgn v[4]!) (pauli2 v[0]! v[1]! v[2]! v[3]!)))

def table1 (name : String) (g : Gate 2) : String := Id.run do
  let mut s := s!"pub const {name}: [[bool; 5]; 4] = [\n"
  for x in bools do
    for z in bools do
      match image1 g x z with
      | some (x', z', f) => s := s ++ s!"    [{b x}, {b z}, {b x'}, {b z'}, {b f}],\n"
      | none => s := s ++ "    compile_error!(\"no Pauli image\"),\n"
  s ++ "];\n"

def table2 (name : String) (g : Gate 4) : String := Id.run do
  let mut s := s!"pub const {name}: [[bool; 9]; 16] = [\n"
  for xa in bools do
    for za in bools do
      for xb in bools do
        for zb in bools do
          match image2 g xa za xb zb with
          | some v =>
            let row := ([xa, za, xb, zb] ++ v).map b
            s := s ++ "    [" ++ ", ".intercalate row ++ "],\n"
          | none => s := s ++ "    compile_error!(\"no Pauli image\"),\n"
  s ++ "];\n"

/-- `(a, b, c, d, e)` with `pauli a b · pauli c d = iᵉ · pauli (a ⊕ c) (b ⊕ d)`. -/
def siteTable : String := Id.run do
  let mut s := "pub const SITE_PRODUCT: [([bool; 4], u8); 16] = [\n"
  for a in bools do
    for bb in bools do
      for c in bools do
        for d in bools do
          let e := [0, 1, 2, 3].find? fun k =>
            decide (Mat.Eq (Mat.mul (pauli a bb) (pauli c d))
              (Mat.smul (GI.iPow k) (pauli (a ^^ c) (bb ^^ d))))
          match e with
          | some k => s := s ++ s!"    ([{b a}, {b bb}, {b c}, {b d}], {k}),\n"
          | none => s := s ++ "    compile_error!(\"no phase\"),\n"
  s ++ "];\n"

def main : IO Unit := do
  IO.print "// SPDX-FileCopyrightText: 2026 The PPVM Authors\n"
  IO.print "// SPDX-License-Identifier: Apache-2.0\n\n"
  IO.print "// @generated by lean/scripts/GenTables.lean from the matrix model in\n"
  IO.print "// lean/PPVM/Kernels/Model.lean. Do not edit by hand.\n"
  IO.print "//\n"
  IO.print "// One-qubit rows: [x, z, x', z', flip] with G† P G = (−1)^flip · P'.\n"
  IO.print "// Two-qubit rows: [xa, za, xb, zb, xa', za', xb', zb', flip].\n\n"
  for (n, g) in [("X", gX), ("Y", gY), ("Z", gZ), ("H", gH), ("S", gS), ("S_DAG", gSdag),
      ("SQRT_X", gSqrtX), ("SQRT_X_DAG", gSqrtXdag), ("SQRT_Y", gSqrtY),
      ("SQRT_Y_DAG", gSqrtYdag)] do
    IO.print (table1 n g ++ "\n")
  for (n, g) in [("CX", gCX), ("CZ", gCZ), ("CY", gCY)] do
    IO.print (table2 n g ++ "\n")
  IO.print siteTable
